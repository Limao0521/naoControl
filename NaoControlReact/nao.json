{
  "info": {
    "name": "NAO Control WebSocket Behaviors",
    "description": "Colección para controlar behaviors del robot NAO via WebSocket",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "🐘 Elephant Behavior",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"elephant\"\n}"
        },
        "url": {
          "raw": "ws://{{nao_ip}}:6671",
          "protocol": "ws",
          "host": ["{{nao_ip}}"],
          "port": "6671"
        },
        "description": "Ejecuta movimiento de elefante con brazos balanceando"
      }
    },
