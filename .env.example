# Copy to .env on the PC only. Never commit the real file.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_ASR_URL=
NAO_GATEWAY_URL=ws://nao.local:6674
NAO_GATEWAY_SECRET=

# Optional secure network manager. It runs separately from Nemotron.
NAO_NETWORK_HOST=nao.local
NAO_NETWORK_BROKER_PORT=6675
NAO_SSH_USER=nao
NAO_SSH_KEY=C:\\Users\\you\\.ssh\\nao_control_ed25519
NAO_NETWORK_ALLOWED_ORIGINS=http://nao.local:3000
