# Copy to .env on the PC only. Never commit the real file.
INTELLIGENCE_PROVIDER=nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_ASR_URL=
NAO_GATEWAY_URL=ws://nao.local:6674
NAO_GATEWAY_SECRET=
GEMMA_BASE_URL=http://127.0.0.1:8080/v1
# Leave empty to discover the first model reported by /v1/models.
GEMMA_MODEL=
