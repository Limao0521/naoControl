# Copy to .env on the PC only. Never commit the real file.
INTELLIGENCE_PROVIDER=nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_ASR_URL=
NAO_GATEWAY_URL=ws://nao.local:6674
NAO_GATEWAY_SECRET=
GEMMA_BASE_URL=http://127.0.0.1:8080/v1
GEMMA_API_KEY=
# Leave empty to discover the first model reported by /v1/models.
GEMMA_MODEL=
# Optional PC microphone wake-word detector. It is available when the PC
# gateway is running (Gemma LAN mode) and starts NAO recording after "NAO".
NAO_KWS_ENABLED=false
NAO_KWS_THRESHOLD=0.995
NAO_KWS_BLOCKSIZE=16000
# Leave empty after importing the model; the bundled default path is used.
NAO_KWS_MODEL_PATH=
NAO_KWS_ENCODER_PATH=
